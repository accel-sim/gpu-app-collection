.version 9.1
.target sm_120a
.address_size 64

.visible .entry k_f16x2_rn(
    .param .u64 out_ptr,
    .param .u64 in_ptr
) {
    .reg .u64 %rd<4>;
    .reg .f32 %f<3>;
    .reg .b32 %r<2>;

    ld.param.u64 %rd0, [out_ptr];
    ld.param.u64 %rd1, [in_ptr];
    ld.global.f32 %f0, [%rd1];
    add.u64 %rd2, %rd1, 4;
    ld.global.f32 %f1, [%rd2];
    cvt.rn.f16x2.f32 %r0, %f0, %f1;
    st.global.u32 [%rd0], %r0;
    ret;
}

