
export GPUAPPS_SETUP_ENVIRONMENT_WAS_RUN=
export GPUAPPS_ROOT="$( cd "$( dirname "$BASH_SOURCE" )" && pwd )"/../
export CUDA_PATH=$CUDA_INSTALL_PATH

if [ ! -n "$CUDA_INSTALL_PATH" ]; then
    echo "ERROR *** CUDA_INSTALL_PATH not set;"
    return
elif [ ! -d "$CUDA_INSTALL_PATH" ]; then
    echo "ERROR *** CUDA_INSTALL_PATH=$CUDA_INSTALL_PATH invalid. directory does not exist.";
    return
else
    NVCC_PATH=`which nvcc`;
    if [ $? != 0 ]; then
        echo "";
        echo "ERROR ** nvcc (from CUDA Toolkit) was not found in PATH but required to build the ISPASS 2009 benchmarks.";
        echo "         Try adding $(CUDA_INSTALL_PATH)/bin/ to your PATH environment variable.";
        echo "";
        return
    fi
fi

export CUDA_VERSION=`nvcc --version | grep release | sed -re 's/.*release ([0-9]+\.[0-9]+).*/\1/'`;
export CUDA_VERSION_MAJOR=`nvcc --version | grep release | sed -re 's/.*release ([0-9]+)\..*/\1/'`;
export CUDAHOME=$CUDA_INSTALL_PATH

# The rodinia makefiles reference these but nothing ever defined them, so their
# -L/-I expanded empty and the link failed to find libcudart. lib64 is the real
# location on every 64-bit toolkit; plain lib is the 32-bit/very-old fallback.
export CUDA_DIR=$CUDA_INSTALL_PATH
if [ -d "$CUDA_INSTALL_PATH/lib64" ]; then
    export CUDA_LIB_DIR=$CUDA_INSTALL_PATH/lib64
else
    export CUDA_LIB_DIR=$CUDA_INSTALL_PATH/lib
fi

# The 4.2 GPU Computing SDK supplies cutil/shrutil, which only the ISPASS-2009
# benchmarks link against. Toolkits from 5.0 on ship those helpers themselves, so
# only pay the download/build cost when an ancient toolkit actually needs it.
if [ $CUDA_VERSION_MAJOR -lt 5 ] && [ ! -d "$NVIDIA_COMPUTE_SDK_LOCATION/../4.2" ]; then
    echo "SDK 4.2 Not detected - installing and building"
    if [ ! -f ./gpucomputingsdk_4.2.9_linux.run ]; then
        wget http://developer.download.nvidia.com/compute/cuda/4_2/rel/sdk/gpucomputingsdk_4.2.9_linux.run
    fi
    chmod u+x gpucomputingsdk_4.2.9_linux.run
    ./gpucomputingsdk_4.2.9_linux.run -- --prefix=`pwd`/4.2 --cudaprefix=$CUDA_INSTALL_PATH
    export NVIDIA_COMPUTE_SDK_LOCATION=`pwd`/4.2
    make -j -i -C $NVIDIA_COMPUTE_SDK_LOCATION/
fi

# The ISPASS-2009 benchmarks link cutil, but the 4.2 SDK only ships a prebuilt
# libcutil_x86_64.a. The sources are in-tree and compile fine, so build the
# archive for whatever host we are actually on rather than failing to link.
GPUAPPS_HOSTARCH=`uname -m`
GPUAPPS_CUTIL_DIR=$NVIDIA_COMPUTE_SDK_LOCATION/../4.2/C
if [ -d "$GPUAPPS_CUTIL_DIR/common/src" ] && \
   [ ! -f "$GPUAPPS_CUTIL_DIR/lib/libcutil_$GPUAPPS_HOSTARCH.a" ]; then
    echo "Building libcutil_$GPUAPPS_HOSTARCH.a from the in-tree 4.2 SDK sources"
    GPUAPPS_CUTIL_TMP=`mktemp -d`
    for f in cutil bank_checker cmd_arg_reader multithreading stopwatch stopwatch_linux; do
        if [ -f "$GPUAPPS_CUTIL_DIR/common/src/$f.cpp" ]; then
            g++ -O2 -fPIC -I"$GPUAPPS_CUTIL_DIR/common/inc" -I"$CUDA_INSTALL_PATH/include" \
                -c "$GPUAPPS_CUTIL_DIR/common/src/$f.cpp" -o "$GPUAPPS_CUTIL_TMP/$f.o" || true
        fi
    done
    if ls "$GPUAPPS_CUTIL_TMP"/*.o >/dev/null 2>&1; then
        mkdir -p "$GPUAPPS_CUTIL_DIR/lib"
        ar rcs "$GPUAPPS_CUTIL_DIR/lib/libcutil_$GPUAPPS_HOSTARCH.a" "$GPUAPPS_CUTIL_TMP"/*.o
    fi
    rm -rf "$GPUAPPS_CUTIL_TMP"
fi

export BINDIR=$GPUAPPS_ROOT/bin/$CUDA_VERSION
export BINSUBDIR=release

export SETENV="export BINDIR=$BINDIR; export BINSUBDIR=$BINSUBDIR; export ROOTOBJDIR=obj_$CUDA_VERSION;"
echo BINDIR=$BINDIR

export MAKE_ARGS=""
export CUDA_CPPFLAGS=""
export NVCC_ADDITIONAL_ARGS=""

################################################################################
# GPU architecture selection
#
# Every new toolkit drops old architectures and adds new ones, so rather than
# maintaining a per-version table here (which silently produced *no* gencode
# flags once the toolkit outran the table), ask nvcc what it actually accepts
# and intersect that with the architectures we want to target.
################################################################################

# Architectures referenced by Makefiles anywhere in this tree. Every one of these
# gets a GENCODE_SMxx value below - either a real flag or empty - so that no
# Makefile can emit a -gencode for an architecture this toolkit rejects.
GPUAPPS_ALL_ARCHS="10 11 12 13 20 21 30 32 35 37 50 52 53 60 61 62 70 72 75 80 86 87 88 89 90 100 103 110 120 121"

# What we'd like to build for, overridable via GPUAPPS_ARCHS="70 80" to cut build time.
GPUAPPS_DESIRED_ARCHS=${GPUAPPS_ARCHS:-"10 13 20 30 35 50 60 62 70 75 80 86 90"}

# --list-gpu-arch landed in CUDA 11; older toolkits need the static fallback below.
GPUAPPS_SUPPORTED_ARCHS=`nvcc --list-gpu-arch 2>/dev/null | sed -e 's/^compute_//' | tr '\n' ' '`
if [ -z "$GPUAPPS_SUPPORTED_ARCHS" ]; then
    case $CUDA_VERSION_MAJOR in
        4)  GPUAPPS_SUPPORTED_ARCHS="10 11 12 13 20 21 30" ;;
        5)  GPUAPPS_SUPPORTED_ARCHS="10 11 12 13 20 21 30 35" ;;
        6)  GPUAPPS_SUPPORTED_ARCHS="10 11 12 13 20 21 30 32 35 37 50" ;;
        7)  GPUAPPS_SUPPORTED_ARCHS="20 21 30 32 35 37 50 52 53" ;;
        8)  GPUAPPS_SUPPORTED_ARCHS="20 21 30 32 35 37 50 52 53 60 61 62" ;;
        9)  GPUAPPS_SUPPORTED_ARCHS="30 32 35 37 50 52 53 60 61 62 70 72" ;;
        10) GPUAPPS_SUPPORTED_ARCHS="30 32 35 37 50 52 53 60 61 62 70 72 75" ;;
        *)  GPUAPPS_SUPPORTED_ARCHS="52 53 60 61 62 70 72 75 80 86 87 89 90" ;;
    esac
fi

# Build the flag set. GENCODE_SMxx is exported through MAKE_ARGS as a make
# command-line override, which beats the ?= and := defaults in every common.mk.
GPUAPPS_BUILD_ARCHS=""
for arch in $GPUAPPS_ALL_ARCHS; do
    if echo " $GPUAPPS_DESIRED_ARCHS " | grep -q " $arch " && \
       echo " $GPUAPPS_SUPPORTED_ARCHS " | grep -q " $arch "; then
        # Bracket syntax rather than code=\"sm_XX,compute_XX\": same SASS+PTX output,
        # but contains no spaces, so passing it through MAKE_ARGS cannot be split
        # into a stray make goal. PTX must stay embedded for GPGPU-Sim to run these.
        gencode="-gencode=arch=compute_${arch},code=[sm_${arch},compute_${arch}]"
        export MAKE_ARGS="$MAKE_ARGS GENCODE_SM${arch}=$gencode"
        export CUDA_CPPFLAGS="$CUDA_CPPFLAGS $gencode"
        GPUAPPS_BUILD_ARCHS="$GPUAPPS_BUILD_ARCHS $arch"
    else
        export MAKE_ARGS="$MAKE_ARGS GENCODE_SM${arch}="
    fi
done

if [ -z "$GPUAPPS_BUILD_ARCHS" ]; then
    echo "ERROR *** No usable GPU architectures. CUDA $CUDA_VERSION supports:"
    echo "          $GPUAPPS_SUPPORTED_ARCHS"
    echo "          but GPUAPPS_ARCHS requested: $GPUAPPS_DESIRED_ARCHS"
    return
fi
echo "Building for SM:$GPUAPPS_BUILD_ARCHS (CUDA $CUDA_VERSION supports: $GPUAPPS_SUPPORTED_ARCHS)"

# Host C++ standard. nvcc 12+ dropped c++11, 13 dropped c++14.
if [ $CUDA_VERSION_MAJOR -ge 12 ]; then
    export CUDA_CPPFLAGS="$CUDA_CPPFLAGS -std=c++17"
elif [ $CUDA_VERSION_MAJOR -ge 11 ]; then
    export CUDA_CPPFLAGS="$CUDA_CPPFLAGS -std=c++14"
elif [ $CUDA_VERSION_MAJOR -ge 8 ]; then
    export CUDA_CPPFLAGS="$CUDA_CPPFLAGS -std=c++11"
fi

# Feature gates consumed by the top-level Makefile to pick the app list.
if [ $CUDA_VERSION_MAJOR -gt 4 ]; then
    export CUDA_GT_4=1
fi
if [ $CUDA_VERSION_MAJOR -gt 7 ]; then
    export CUDA_GT_7=1
    export NVCC_ADDITIONAL_ARGS="--cudart shared"
fi
if [ $CUDA_VERSION_MAJOR -gt 10 ]; then
    export CUDA_GT_10=1
fi

export MAKE_ARGS="$MAKE_ARGS CUBLAS_LIB=cublas_static CUDNN_LIB=cudnn_static"
export GENCODE_FLAGS=$CUDA_CPPFLAGS

export CUDA_CPPFLAGS="$CUDA_CPPFLAGS $NVCC_ADDITIONAL_ARGS"
echo MAKE_ARGS=$MAKE_ARGS

export GPUAPPS_SETUP_ENVIRONMENT_WAS_RUN=1
